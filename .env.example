# Copie ce fichier en `.env` et renseigne les valeurs. `.env` est ignoré par git.
# Toute variable ajoutée ici doit l'être aussi dans le §9 de CLAUDE.md.
# Aucune valeur, jamais, dans ce fichier : il est committé.

# --- Base de données (Neon) ---
# Connexion « pooled », utilisée par l'application.
DATABASE_URL=
# Connexion directe, requise par les migrations Drizzle.
DATABASE_URL_UNPOOLED=

# --- API externes ---
# Clé API PageSpeed Insights.
PSI_API_KEY=

# --- Surface d'ops (CLAUDE.md §8) ---
# Jeton porteur de la surface d'ops. Rotation à la moindre suspicion.
OPS_TOKEN=

# --- Observabilité (Sentry) ---
# DSN client. Préfixé PUBLIC_ : exposé au navigateur, public par nature.
# Sa présence au moment du build embarque le SDK navigateur (48 ko gz) : la
# laisser vide tant que le site n'envoie aucun JavaScript au client.
PUBLIC_SENTRY_DSN=
# DSN serveur et jobs.
SENTRY_DSN=
# Jeton d'upload des source maps. GitHub Actions uniquement.
SENTRY_AUTH_TOKEN=

# --- Infrastructure (GitHub Actions uniquement) ---
# Création et suppression des branches Neon éphémères.
NEON_API_KEY=
# Déploiement et purge de cache Netlify.
NETLIFY_AUTH_TOKEN=

# --- Site ---
# URL canonique, utilisée pour les liens absolus. Sans valeur, le site ne
# publie aucune URL canonique — préférable à en publier une qui ne résout pas.
SITE_URL=
