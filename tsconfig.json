{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node", "vitest/globals"],
    // No `baseUrl`: TypeScript 6 deprecates it and TypeScript 7 drops it.
    // Without it, `paths` resolve relative to this file, which is what we
    // wanted anyway. This teaches `tsc` only — the same alias is mirrored in
    // astro.config.mjs for the build and in vitest.config.ts for the tests.
    // The three cannot see each other, so tests/unit/path-alias.test.ts holds
    // them together.
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.astro", "**/*.mjs"],
  "exclude": ["dist", "dist-jobs", "node_modules", ".netlify", "coverage", ".stryker-tmp"]
}
