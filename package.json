{
  "name": "observatoire-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mesures automatisées de qualité et d'accessibilité technique des sites des communes françaises",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:jobs": "tsc -p tsconfig.jobs.json",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/budget.mjs 60 vitest run --project unit --coverage",
    "test:watch": "vitest --project unit",
    "test:integration": "node scripts/budget.mjs 240 vitest run --project integration --no-file-parallelism",
    "test:e2e": "node scripts/budget.mjs 360 playwright test",
    "test:contract": "vitest run --project contract",
    "test:mutation": "stryker run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm build:jobs"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.0",
    "@sentry/astro": "^10.19.0",
    "astro": "^7.2.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.56.1",
    "@stryker-mutator/core": "^9.2.0",
    "@stryker-mutator/vitest-runner": "^9.2.0",
    "@types/node": "^22.18.10",
    "@types/pg": "^8.20.4",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.38.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.9.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
